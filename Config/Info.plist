<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>别坐过站</string>
	<key>ArrivalAppGroup</key>
	<string>$(ARRIVAL_APP_GROUP_IDENTIFIER)</string>
	<key>ArrivalAMapSearchKey</key>
	<string>$(ARRIVAL_AMAP_SEARCH_KEY)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(ARRIVAL_APP_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>arrivalalarm</string>
			</array>
		</dict>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>开始守候后，别坐过站用位置判断你是否接近下车站。以后再次进入同一站的提醒范围时，iPhone 会发出提醒。你可随时停止。</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>iosamap</string>
		<string>baidumap</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
