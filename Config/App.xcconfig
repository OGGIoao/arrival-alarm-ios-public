PRODUCT_NAME = $(TARGET_NAME)
ARRIVAL_APP_BUNDLE_IDENTIFIER = io.github.oggioao.arrivalalarm.prototype
ARRIVAL_APP_GROUP_IDENTIFIER = group.$(ARRIVAL_APP_BUNDLE_IDENTIFIER)
PRODUCT_BUNDLE_IDENTIFIER = $(ARRIVAL_APP_BUNDLE_IDENTIFIER)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
CODE_SIGN_ENTITLEMENTS = Config/App.entitlements
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1
